#!/bin/sh
# Runs the link and ID check when staged files touch the documents.
if git diff --cached --name-only | grep -Eq '^(docs/|AGENTS\.md$|tools/link-check/)'; then
  node tools/link-check/check.mts || exit 1
fi
# Then, only when staged files touch code or workspace config, runs lint, typecheck and the module check.
if git diff --cached --name-only | grep -Eq '^(apps/|packages/|tools/module-check/|tools/link-check/|package\.json$|pnpm-workspace\.yaml$|pnpm-lock\.yaml$|turbo\.json$|tsconfig\.base\.json$|eslint\.config\.mjs$|\.prettierrc\.json$|\.prettierignore$|\.editorconfig$|\.nvmrc$)'; then
  node tools/module-check/check.mts || exit 1
  if [ -d node_modules ]; then
    pnpm run lint && pnpm run typecheck || exit 1
  else
    echo "Lint and typecheck skipped: dependencies are not installed. Run pnpm install." >&2
  fi
fi
