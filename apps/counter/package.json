{
  "name": "@apparel-os/counter",
  "version": "0.0.0",
  "private": true,
  "description": "The offline counter app (offline-counter.md 5.1): the build, its guard against the costing entry point, the golden-case test page, and the enrolment and device sign-in pages",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@apparel-os/calculations": "workspace:*",
    "@apparel-os/domain": "workspace:*",
    "@apparel-os/schemas": "workspace:*",
    "@apparel-os/ui": "workspace:*",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
