          "kind": "public"
        },
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The error envelope (code-house-rules 12.3)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-error-codes": [
              "kernel.invalid-request"
            ]
          },
          "500": {
            "description": "The error envelope (code-house-rules 12.3)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-error-codes": [
              "kernel.failed"
            ]
          },
          "503": {
            "description": "The error envelope (code-house-rules 12.3)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-error-codes": [
              "kernel.timed-out"
            ]
          }
        }
