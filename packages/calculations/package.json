{
  "name": "@apparel-os/calculations",
  "version": "0.0.0",
  "private": true,
  "description": "Shared calculations (shared-calculations.md, GC-7): selling at the root entry point, costing at ./costing (server only), a booking's totals at ./booking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./costing": {
      "types": "./dist/costing/index.d.ts",
      "default": "./dist/costing/index.js"
    },
    "./booking": {
      "types": "./dist/booking/index.d.ts",
      "default": "./dist/booking/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "dependencies": {
    "@apparel-os/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
