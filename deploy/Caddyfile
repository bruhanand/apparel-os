{
	# Vercel sits in front of this server; its addresses are not fixed, so the forwarded address is trusted as sent.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$AOS_HOST} {
	# flush_interval -1 keeps the live-update stream (SSE) from being buffered.
	reverse_proxy app:3000 {
		flush_interval -1
	}
}
